// Inicializa os territórios com dados fixos
void inicializarTerritorios(Territorio *terr) {
    const char *nomes[MAX_TERRITORIOS] = {"Bom Jesus", "Sao Geraldo", "Serra", "Cruzeiro", "Nova Floresta"};
    const char *cores[MAX_TERRITORIOS] = {"azul", "vermelho", "verde", "rosa", "preta"};
    const int tropas_iniciais[MAX_TERRITORIOS] = {5, 5, 6, 3, 7};

    for (int i = 0; i < MAX_TERRITORIOS; i++) {
        strncpy(terr[i].nome, nomes[i], MAX_NOME);
        strncpy(terr[i].cor, cores[i], MAX_COR);
        terr[i].tropas = tropas_iniciais[i];
        terr[i].conquistado = 0;
    }
}

// Exibe o estado atual dos territórios
void exibirMapa(const Territorio *terr) {
    printf("
Estado atual do mapa:
");
    printf("----------------------------------
");
    for (int i = 0; i < MAX_TERRITORIOS; i++) {
        printf("%d) %s - Cor: %s - Tropas: %d%s
", 
            i + 1, terr[i].nome, terr[i].cor, terr[i].tropas,
            terr[i].conquistado ? " (Conquistado)" : "");
    }
    printf("----------------------------------
");
}

// Lê inteiro entre min e max (inclusive) com tratamento simples
int lerInteiro(int min, int max) {
    int valor;
    while (1) {
        if (scanf("%d", &valor) != 1) {
            while (getchar() != '
'); // limpa buffer
            printf("Entrada invalida. Tente novamente: ");
            continue;
        }
        if (valor < min || valor > max) {
            printf("Valor fora do intervalo [%d-%d]. Tente novamente: ", min, max);
            continue;
        }
        while (getchar() != '
');
        return valor;
    }
}

// Simula a batalha entre atacante e defensor
void realizarBatalha(Territorio *atacante, Territorio *defensor) {
    if (atacante->tropas <= 1) {
        printf("Atacante (%s) nao tem tropas suficientes para atacar.
", atacante->nome);
        return;
    }

    int dado_ataque = rand() % atacante->tropas + 1;
    int dado_defesa = rand() % defensor->tropas + 1;

    printf("
Batalha: %s (Atacante) vs %s (Defensor)
", atacante->nome, defensor->nome);
    printf("Dado Ataque: %d
", dado_ataque);
    printf("Dado Defesa: %d
", dado_defesa);

    if (dado_ataque >= dado_defesa) {
        defensor->tropas--;
        printf("%s perde 1 tropa! Tropas restantes: %d
", defensor->nome, defensor->tropas);
        if (defensor->tropas <= 0) {
            defensor->conquistado = 1;
            printf("%s foi conquistado por %s!
", defensor->nome, atacante->nome);
            defensor->tropas = 1;
            atacante->tropas--;
        }
    } else {
        atacante->tropas--;
        printf("%s perde 1 tropa! Tropas restantes: %d
", atacante->nome, atacante->tropas);
    }
}

// Verifica se as missões estão cumpridas:
// 1) Destruir exército verde (tropas == 0 em exército verde)
// 2) Conquistar 3 territórios (quantidade com conquistado == 1)
int verificarMissao(const Territorio *terr) {
    int verdes_destruidos = 0;
    int conquistados = 0;

    for (int i = 0; i < MAX_TERRITORIOS; i++) {
        if (strcmp(terr[i].cor, "verde") == 0 && terr[i].tropas == 0) {
            verdes_destruidos = 1;
        }
        if (terr[i].conquistado) {
            conquistados++;
        }
    }

    printf("
Status das missões:
");
    printf("1) Destruir o exército verde: %s
", verdes_destruidos ? "Concluido" : "Nao concluido");
    printf("2) Conquistar 3 territorios: %s (%d/3)
", (conquistados >= 3) ? "Concluido" : "Nao concluido", conquistados);

    if (verdes_destruidos && conquistados >= 3) {
        printf("
Parabens! Voce concluiu todas as missoes e venceu o jogo!
");
        return 1; // Vitória
    }
    return 0;
}

// Menu principal com interação
void menuPrincipal(Territorio *terr) {
    int opcao = -1;
    int jogo_ativo = 1;

    while (jogo_ativo) {
        exibirMapa(terr);
        printf("Menu:
");
        printf("1 - Atacar
");
        printf("2 - Verificar Missao
");
        printf("0 - Sair
");
        printf("Escolha uma opcao: ");

        opcao = lerInteiro(0, 2);

        switch (opcao) {
            case 1: {
                printf("Escolha o territorio atacante (1-%d): ", MAX_TERRITORIOS);
                int atacante_idx = lerInteiro(1, MAX_TERRITORIOS) - 1;

                if (terr[atacante_idx].conquistado) {
                    printf("Este território foi conquistado e nao pode atacar.
");
                    break;
                }

                printf("Escolha o territorio defensor (1-%d): ", MAX_TERRITORIOS);
                int defensor_idx = lerInteiro(1, MAX_TERRITORIOS) - 1;
                if (atacante_idx == defensor_idx) {
                    printf("Atacante e defensor nao podem ser o mesmo território.
");
                    break;
                }

                realizarBatalha(&terr[atacante_idx], &terr[defensor_idx]);
                break;
            }
            case 2:
                if (verificarMissao(terr)) {
                    jogo_ativo = 0;
                }
                break;
            case 0:
                jogo_ativo = 0;
                break;
            default:
                printf("Opcao invalida.
");
                break;
        }
    }
}
