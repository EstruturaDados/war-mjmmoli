#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Definicao da estrutura para um Territorio
struct Territorio {
    char nome[50];
    char cor_exercito[20];
    int num_tropas;
};

// Tamanho fixo do mapa para o nivel Novato
#define NUM_TERRITORIOS_NOVATO 5

// Funcao para exibir o estado atual do mapa
void exibir_mapa_novato(struct Territorio mapa[]) {
    printf("\n--- Estado Atual do Mapa (Nível Novato) ---\n");
    for (int i = 0; i < NUM_TERRITORIOS_NOVATO; i++) {
        printf("[%d] %s | Exército: %s | Tropas: %d\n", 
               i + 1, 
               mapa[i].nome, 
               mapa[i].cor_exercito, 
               mapa[i].num_tropas);
    }
    printf("------------------------------------------\n");
}

int main() {
    // Vetor estático de 5 elementos (struct Territorio)
    struct Territorio mapa[NUM_TERRITORIOS_NOVATO];
    
    char buffer[100]; // Buffer para fgets
    
    printf("--- Cadastro Inicial de Territórios (Nível Novato) ---\n");

    // Loop para cadastrar cada um dos 5 territorios
    for (int i = 0; i < NUM_TERRITORIOS_NOVATO; i++) {
        printf("\nCadastrando Território #%d:\n", i + 1);

        // 1. Nome do Território (usando fgets para ler a linha)
        printf("Nome: ");
        // Limpar o '\n' restante se houver (útil após scanf)
        fflush(stdin); 
        // Le a string, garantindo que nao haja overflow
        if (fgets(buffer, sizeof(buffer), stdin) != NULL) {
            // Remove o '\n' lido por fgets, se existir
            buffer[strcspn(buffer, "\n")] = 0; 
            // Copia a string limpa para o struct
            strcpy(mapa[i].nome, buffer);
        } else {
            // Tratamento de erro simples
            strcpy(mapa[i].nome, "Erro");
        }
        
        // 2. Cor do Exército
        printf("Cor do Exército: ");
        fflush(stdin);
        if (fgets(buffer, sizeof(buffer), stdin) != NULL) {
            buffer[strcspn(buffer, "\n")] = 0; 
            strcpy(mapa[i].cor_exercito, buffer);
        } else {
            strcpy(mapa[i].cor_exercito, "Erro");
        }

        // 3. Número de Tropas (usando scanf)
        printf("Número de Tropas: ");
        // Leitura de inteiro (pode deixar o '\n' no buffer)
        if (scanf("%d", &mapa[i].num_tropas) != 1) {
            mapa[i].num_tropas = 0; // Valor padrao em caso de erro
        }
    }

    // Exibir o mapa após o cadastro
    exibir_mapa_novato(mapa);
    
    printf("\nFim do Nível Novato.\n");

    return 0;
}{
