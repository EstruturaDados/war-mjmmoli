#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <locale.h>
#include <time.h>

#define NUM_TERRITORIOS 5
#define MAX_STRING 50
#define NUM_MISSOES 2

typedef struct {
    char nome[MAX_STRING];
    char cor[20];
    int tropas;
} Territorio;

Territorio* alocarMapa(void) {
    Territorio* mapa = (Territorio*) calloc(NUM_TERRITORIOS, sizeof(Territorio));
    if (!mapa) {
        printf("Erro na alocacao de memoria.
");
        exit(1);
    }
    return mapa;
}

void inicializarTerritorios(Territorio* mapa) {
    strcpy(mapa[0].nome, "Sao Geraldo");
    strcpy(mapa[0].cor, "vermelho");
    mapa[0].tropas = 4;

    strcpy(mapa[1].nome, "Bom Jesus");
    strcpy(mapa[1].cor, "amarelo");
    mapa[1].tropas = 7;

    strcpy(mapa[2].nome, "Nova Floresta");
    strcpy(mapa[2].cor, "verde");
    mapa[2].tropas = 3;

    strcpy(mapa[3].nome, "Maria Helena");
    strcpy(mapa[3].cor, "roxo");
    mapa[3].tropas = 7;

    strcpy(mapa[4].nome, "Adelaide");
    strcpy(mapa[4].cor, "cinza");
    mapa[4].tropas = 5;
}

void liberarMemoria(Territorio* mapa) {
    free(mapa);
}

void exibirMapa(const Territorio* mapa) {
    printf("
--- MAPA ATUAL ---
");
    printf("ID | Nome          | Cor Dominante | Tropas
");
    printf("---------------------------------------------
");
    for (int i = 0; i < NUM_TERRITORIOS; i++) {
        printf("%2d | %-13s | %-13s | %d
", i+1, mapa[i].nome, mapa[i].cor, mapa[i].tropas);
    }
    printf("---------------------------------------------
");
}

void exibirMissao(int idMissao) {
    printf("
--- Missao Secreta ---
");
    switch (idMissao) {
        case 1:
            printf("Conquistar todos os territorios dominados pelo exército 'roxo'.
");
            break;
        case 2:
            printf("Conquistar no minimo tres territorios.
");
            break;
        default:
            printf("Missao desconhecida.
");
            break;
    }
}

void limparBufferEntrada(void) {
    int c;
    while ((c = getchar()) != '
' && c != EOF);
}

void simularAtaque(Territorio* origem, Territorio* destino) {
    int ataque = (rand() % 6 + 1) + (rand() % 6 + 1);
    int defesa = (rand() % 6 + 1) + (rand() % 6 + 1);

    printf("Ataque (%s): %d
", origem->nome, ataque);
    printf("Defesa (%s): %d
", destino->nome, defesa);

    if (ataque > defesa) {
        destino->tropas--;
        printf("Defensor perde 1 tropa!
");
    } else {
        origem->tropas--;
        printf("Atacante perde 1 tropa!
");
    }

    if (destino->tropas <= 0) {
        printf("Territorio %s conquistado pelo exército %s!
", destino->nome, origem->cor);
        strcpy(destino->cor, origem->cor);
        destino->tropas = 1;
        origem->tropas--;
    }
}

void faseDeAtaque(Territorio* mapa, const char* corJogador) {
    int origem, destino;

    exibirMapa(mapa);
    printf("Digite o numero do territorio de origem (seu territorio): ");
    if (scanf("%d", &origem) != 1) {
        printf("Entrada invalida!
");
        limparBufferEntrada();
        return;
    }
    limparBufferEntrada();

    if (origem < 1 || origem > NUM_TERRITORIOS) {
        printf("Territorio de origem invalido.
");
        return;
    }

    if (strcmp(mapa[origem - 1].cor, corJogador) != 0) {
        printf("Voce so pode atacar a partir de seus proprios territorios.
");
        return;
    }

    if (mapa[origem - 1].tropas < 2) {
        printf("Tem que ter pelo menos 2 tropas para atacar.
");
        return;
    }

    printf("Digite o numero do territorio de destino: ");
    if (scanf("%d", &destino) != 1) {
        printf("Entrada invalida!
");
        limparBufferEntrada();
        return;
    }
    limparBufferEntrada();

    if (destino < 1 || destino > NUM_TERRITORIOS) {
        printf("Territorio de destino invalido.
");
        return;
    }

    if (origem == destino) {
        printf("Origem e destino nao podem ser o mesmo.
");
        return;
    }

    if (strcmp(mapa[origem - 1].cor, mapa[destino - 1].cor) == 0) {
        printf("Nao pode atacar seu proprio territorio.
");
        return;
    }

    simularAtaque(&mapa[origem - 1], &mapa[destino - 1]);
}

int sortearMissao(void) {
    return (rand() % NUM_MISSOES) + 1;
}

int verificarVitoria(const Territorio* mapa, const char* corJogador, int idMissao) {
    if (idMissao == 1) {
        // Jogador deve dominar todos os territorios que eram originalmente roxos
        for (int i = 0; i < NUM_TERRITORIOS; i++) {
            // Considera que a missão é conquistar todos anteriormente 'Maria Helena' como exemplo
            if (strcmp(mapa[i].cor, "roxo") == 0 && strcmp(mapa[i].cor, corJogador) != 0) {
                return 0;
            }
        }
        return 1;
    } else if (idMissao == 2) {
        int count = 0;
        for (int i = 0; i < NUM_TERRITORIOS; i++) {
            if (strcmp(mapa[i].cor, corJogador) == 0) count++;
        }
        return (count >= 3);
    }
    return 0;
}

int main() {
    setlocale(LC_ALL, "pt_BR.UTF-8");
    srand((unsigned)time(NULL));

    Territorio* mapa = alocarMapa();
    inicializarTerritorios(mapa);

    char corJogador[20] = "vermelho";
    int missao = sortearMissao();
    int opcao;

    do {
        exibirMapa(mapa);
        exibirMissao(missao);
        printf("
=== Menu de Acoes ===
");
        printf("1 - Fase de ataque
2 - Verificar vitoria
0 - Sair do jogo
Escolha a opcao: ");

        if (scanf("%d", &opcao) != 1) {
            printf("Entrada invalida. Tente novamente.
");
            limparBufferEntrada();
            continue;
        }
        limparBufferEntrada();

        switch (opcao) {
            case 1:
                faseDeAtaque(mapa, corJogador);
                break;
            case 2:
                if (verificarVitoria(mapa, corJogador, missao)) {
                    printf("Parabens, voce cumpriu sua missao e venceu o jogo!
");
                    opcao = 0;
                } else {
                    printf("Missao nao cumprida ainda. Continue jogando!
");
                }
                break;
            case 0:
                printf("Encerrando o jogo.
");
                break;
            default:
                printf("Opcao invalida. Tente novamente.
");
        }

        printf("Pressione Enter para continuar...");
        getchar();

    } while(opcao != 0);

    liberarMemoria(mapa);
    return 0;
}
